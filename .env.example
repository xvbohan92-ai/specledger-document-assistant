# Export these variables before launching; Settings reads process environment.
SPECLEDGER_BACKEND=docling
SPECLEDGER_DATA=data
# rules | base | finetuned. Trained checkpoints are local artifacts.
SPECLEDGER_FIELD_MAPPER=rules
# Optional model directory independent from the selected ledger data directory.
# SPECLEDGER_FIELD_MODELS=/absolute/path/data/field-models
